<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <title>Verify your email | Eshop</title>
    <style>
      @media only screen and (max-width: 600px) {
        .outer-padding { padding: 24px 12px !important; }
        .content-padding { padding: 32px 24px !important; }
        .email-heading { font-size: 28px !important; line-height: 36px !important; }
        .verification-code { font-size: 36px !important; letter-spacing: 8px !important; }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f1f5f9; color: #334155; font-family: Arial, Helvetica, sans-serif; -webkit-text-size-adjust: 100%;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; mso-hide: all;">
      Welcome to Eshop. Verify your email to finish signing up. Your code expires in 5 minutes.
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f1f5f9">
      <tr>
        <td class="outer-padding" align="center" style="padding: 48px 16px;">
          <!--[if mso]>
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0"><tr><td>
          <![endif]-->
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 560px;">
            <tr>
              <td align="center" style="padding: 0 0 24px;">
                <p style="margin: 0; color: #0f172a; font-size: 26px; font-weight: 700; letter-spacing: -1px;">eshop<span style="color: #0f766e;">.</span></p>
              </td>
            </tr>
            <tr>
              <td bgcolor="#ffffff" style="border: 1px solid #e2e8f0; border-radius: 16px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td class="content-padding" bgcolor="#0f172a" style="padding: 40px; border-radius: 15px 15px 0 0; border-top: 4px solid #2dd4bf;">
                      <p style="margin: 0 0 16px; color: #5eead4; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;">One last step</p>
                      <h1 class="email-heading" style="margin: 0 0 12px; color: #ffffff; font-size: 34px; font-weight: 700; line-height: 42px; letter-spacing: -1px;">Great finds start here.</h1>
                      <p style="margin: 0; color: #cbd5e1; font-size: 16px; line-height: 26px;">Verify your email to finish setting up your account.</p>
                    </td>
                  </tr>
                  <tr>
                    <td class="content-padding" style="padding: 36px 40px 40px;">
                      <p style="margin: 0 0 12px; color: #0f172a; font-size: 18px; font-weight: 700; line-height: 28px; overflow-wrap: anywhere;">Hi <%= name %>,</p>
                      <p style="margin: 0 0 28px; font-size: 16px; line-height: 26px;">Welcome to Eshop! Enter the verification code below on the sign-up screen to activate your account.</p>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td align="center" bgcolor="#f0fdfa" style="padding: 24px 12px; border: 1px solid #99f6e4; border-radius: 12px;">
                            <p style="margin: 0 0 12px; color: #115e59; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;">Your verification code</p>
                            <p class="verification-code" style="margin: 0 0 12px; color: #0f172a; font-family: 'Courier New', Courier, monospace; font-size: 44px; font-weight: 700; line-height: 56px; letter-spacing: 10px;"><%= otp %></p>
                            <p style="margin: 0; color: #115e59; font-size: 13px; line-height: 20px;">Valid for <strong>5 minutes</strong></p>
                          </td>
                        </tr>
                      </table>
                      <p style="margin: 24px 0 0; font-size: 14px; line-height: 23px;"><strong style="color: #0f172a;">Keep this code private.</strong> Never share it with anyone, including anyone claiming to be from Eshop.</p>
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 28px;">
                        <tr>
                          <td style="padding-top: 24px; border-top: 1px solid #e2e8f0;">
                            <p style="margin: 0; color: #64748b; font-size: 13px; line-height: 22px;">Didn't create an account? You can safely ignore this email.</p>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 24px 16px 0;">
                <p style="margin: 0 0 6px; color: #475569; font-size: 13px; font-weight: 700; line-height: 20px;">The Eshop team</p>
                <p style="margin: 0; color: #64748b; font-size: 12px; line-height: 20px;">This is an automated email. Please do not reply.</p>
              </td>
            </tr>
          </table>
          <!--[if mso]>
          </td></tr></table>
          <![endif]-->
        </td>
      </tr>
    </table>
  </body>
</html>
