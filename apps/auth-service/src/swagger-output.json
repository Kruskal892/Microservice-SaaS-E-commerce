{
  "swagger": "2.0",
  "info": {
    "title": "Auth Service API",
    "description": "Authentication, registration, and email verification API",
    "version": "1.0.0"
  },
  "host": "localhost:6001",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Hello API"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/user-registration": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request a registration OTP",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Example Customer"
                },
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": [
                "name",
                "email",
                "password"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OTP sent to the supplied email address.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "OTP sent. Please check your account"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/verify-registration": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify the OTP and create a user account",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Example Customer"
                },
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "otp": {
                  "type": "string",
                  "example": "1234"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": [
                "name",
                "email",
                "otp",
                "password"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User account created.",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "User registered successfully!"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in and set access and refresh cookies",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": [
                "email",
                "password"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login succeeded; access_token and refresh_token cookies set.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Login success"
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "507f1f77bcf86cd799439011"
                    },
                    "email": {
                      "type": "string",
                      "example": "customer@example.com"
                    },
                    "name": {
                      "type": "string",
                      "example": "Example Customer"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    }
  }
}