{
  "swagger": "2.0",
  "info": {
    "title": "Auth Service API",
    "description": "Authentication, registration, email verification, protected current-user lookup, cookie-based access-token refresh, and password recovery with expiring single-use reset authorization. Existing JWTs are not revoked by password reset; refresh tokens are not rotated. See endpoint descriptions.",
    "version": "1.0.0"
  },
  "host": "localhost:6001",
  "basePath": "/",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Hello API"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/user-registration": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request or resend a registration OTP",
        "description": "Uses the same endpoint for initial delivery and resend. Validates registration details and rejects existing accounts. Redis SET NX enforces the 60-second cooldown and INCR tracks the two-request quota. After SMTP acceptance the code is stored for five minutes and cooldown is refreshed. SMTP failure preserves the previous code and still consumes quota; storage timeouts can leave delivery unconfirmed. Sending is expected to finish within the cooldown.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Example Customer"
                },
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": ["name", "email", "password"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OTP sent to the supplied email address.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "OTP sent. Please check your account"
                },
                "retryAfterSeconds": {
                  "type": "number",
                  "example": 60
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Invalid details, existing account, or OTP request restrictions. Restrictions include details.retryAfterSeconds.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Please wait before requesting another OTP"
                },
                "details": {
                  "type": "object",
                  "properties": {
                    "retryAfterSeconds": {
                      "type": "number",
                      "example": 60
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "503": {
            "description": "Redis is not ready or delivery could not be confirmed. A delivery failure includes details.retryAfterSeconds when available.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Unable to confirm a verification code was sent. Check your email before trying again."
                },
                "details": {
                  "type": "object",
                  "properties": {
                    "retryAfterSeconds": {
                      "type": "number",
                      "example": 60
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/verify-registration": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Verify the OTP and create a user account",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Example Customer"
                },
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "otp": {
                  "type": "string",
                  "example": "1234"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": ["name", "email", "otp", "password"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User account created.",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "User registered successfully!"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in and set access and refresh cookies",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": ["email", "password"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login succeeded; access_token and refresh_token cookies set.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Login success"
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "507f1f77bcf86cd799439011"
                    },
                    "email": {
                      "type": "string",
                      "example": "customer@example.com"
                    },
                    "name": {
                      "type": "string",
                      "example": "Example Customer"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/forgot-password-user": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Request a password-recovery OTP",
        "description": "Validates and normalizes email, then sends a four-digit recovery OTP expiring after five minutes. Recovery codes and attempts are separate from registration; locks, request limits and cooldown remain shared. Failed delivery still consumes quota. Verify the code to obtain a single-use reset token.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                }
              },
              "required": ["email"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SMTP accepted the recovery email and Redis OTP/cooldown writes completed; inbox delivery is not guaranteed.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "OTP sent successfully. Please check your account."
                },
                "retryAfterSeconds": {
                  "type": "number",
                  "example": 60
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Invalid body/email, unknown user, or shared OTP restrictions.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Invalid email format"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected body, database, Redis, template, or SMTP failure.",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Something went wrong please try again"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "503": {
            "description": "Redis unavailable or email delivery could not be confirmed.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Unable to confirm a verification code was sent. Check your email before trying again."
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/reset-password-user": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Reset a password using single-use authorization",
        "description": "Requires the resetToken from recovery OTP verification and the same normalized email. Validates an 8-128 character replacement password, hashes it with bcrypt, atomically consumes the five-minute token, then conditionally updates only the verified account with its original password hash. Replay, expiry and grants superseded by a password change are rejected. A database failure after consumption requires a new recovery request. Sends a best-effort change notification; no automatic login or JWT revocation is performed.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "resetToken": {
                  "type": "string",
                  "example": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
                },
                "newPassword": {
                  "type": "string",
                  "example": "new-example-password"
                }
              },
              "required": ["email", "resetToken", "newPassword"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Password changed; sign in with the new password.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Password reset successfully. Please sign in with your new password."
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Invalid request/password or invalid, expired, consumed, wrong-account or superseded reset token.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Invalid or expired password reset token"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Hashing, Redis or database failure. A token consumed before a database failure is not restored.",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Something went wrong please try again"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/verify-forgot-password-user": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Verify a password-recovery OTP",
        "description": "Validates normalized email and a four-digit recovery code. Atomically checks locks, enforces three failed attempts, consumes the purpose-specific OTP, and creates a five-minute single-use reset grant. Returns a random 256-bit resetToken; Redis stores one SHA-256 digest bound to the account ID and current password hash. A new grant supersedes the previous grant for that email.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "otp": {
                  "type": "string",
                  "example": "1234"
                }
              },
              "required": ["email", "otp"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recovery OTP consumed and single-use reset authorization issued.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "OTP verified. You can now reset your password."
                },
                "resetToken": {
                  "type": "string",
                  "example": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
                },
                "expiresInSeconds": {
                  "type": "number",
                  "example": 300
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Missing email or OTP, expired/invalid code, incorrect code, or attempt lockout.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Expired or invalid OTP!"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected request handling or Redis failure.",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Something went wrong please try again"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/refresh-token": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh the access-token cookie",
        "description": "Requires the refresh_token cookie issued by login; no JSON body or Authorization-header fallback. Verifies the refresh JWT and checks that its user still exists. Sets a new 15-minute access JWT in an HttpOnly, Secure, SameSite=None cookie with seven-day retention. Does not rotate or extend the refresh token, revoke sessions, or return token values in JSON. Browser callers must include credentials.",
        "responses": {
          "201": {
            "description": "Access token refreshed; access_token Set-Cookie header sent.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Access token refreshed successfully"
                },
                "success": {
                  "type": "boolean",
                  "example": true
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Refresh token missing, invalid, expired, not yet active, missing required claims, or associated user no longer exists.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Unauthorized: Invalid or expired refresh token"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected database, JWT configuration, or signing failure.",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Something went wrong please try again"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/logged-in-user": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the authenticated user",
        "description": "Requires an access_token cookie or Authorization header token. Shared middleware verifies the access JWT and loads the existing account. Returns only public id, email, and name fields with Cache-Control: no-store. Does not create a session or refresh tokens; the client may call the refresh endpoint after a 401 and retry once.",
        "responses": {
          "200": {
            "description": "Authenticated account; no password hash or token values.",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "507f1f77bcf86cd799439011"
                    },
                    "email": {
                      "type": "string",
                      "example": "customer@example.com"
                    },
                    "name": {
                      "type": "string",
                      "example": "Example Customer"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "401": {
            "description": "Access token missing, invalid, expired, missing claims, or associated account deleted.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Unauthorized: Access token is missing"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected database or JWT configuration failure.",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Something went wrong please try again"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    }
  }
}
