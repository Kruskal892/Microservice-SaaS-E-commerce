{
  "swagger": "2.0",
  "info": {
    "title": "Auth Service API",
    "description": "Authentication, registration, email verification, and incomplete password recovery API. Password reset is disabled until secure verification is implemented; see endpoint descriptions.",
    "version": "1.0.0"
  },
  "host": "localhost:6001",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Hello API"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/user-registration": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request a registration OTP",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Example Customer"
                },
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": [
                "name",
                "email",
                "password"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OTP sent to the supplied email address.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "OTP sent. Please check your account"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/verify-registration": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify the OTP and create a user account",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Example Customer"
                },
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "otp": {
                  "type": "string",
                  "example": "1234"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": [
                "name",
                "email",
                "otp",
                "password"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User account created.",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": true
                },
                "message": {
                  "type": "string",
                  "example": "User registered successfully!"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in and set access and refresh cookies",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "password": {
                  "type": "string",
                  "example": "example-password"
                }
              },
              "required": [
                "email",
                "password"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login succeeded; access_token and refresh_token cookies set.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Login success"
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "507f1f77bcf86cd799439011"
                    },
                    "email": {
                      "type": "string",
                      "example": "customer@example.com"
                    },
                    "name": {
                      "type": "string",
                      "example": "Example Customer"
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/forgot-password-user": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request a password-recovery OTP",
        "description": "Sends a four-digit OTP using the recovery email template. The code expires after five minutes. Email is used unchanged and shares registration OTP keys and limits. Request counters are incremented before delivery, so failures may still consume a request. Password reset is disabled until secure verification is implemented.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                }
              },
              "required": [
                "email"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SMTP accepted the recovery email and Redis OTP/cooldown writes completed; inbox delivery is not guaranteed.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "OTP sent successfully. Please check your account."
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Missing email, unknown user, or shared OTP restrictions.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Email is required!"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected body, database, Redis, template, or SMTP failure.",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Something went wrong please try again"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/reset-password-user": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Password reset is temporarily unavailable",
        "description": "Always rejects requests without reading or updating an account. Secure single-use reset authorization must be implemented before this endpoint is enabled.",
        "responses": {
          "503": {
            "description": "Password reset is disabled.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Password reset is unavailable until secure verification is implemented."
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    },
    "/api/verify-forgot-password-user": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify a password-recovery OTP",
        "description": "Awaits shared OTP validation and then consumes the matching code. No reset authorization is issued or stored. Password reset remains disabled.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "customer@example.com"
                },
                "otp": {
                  "type": "string",
                  "example": "1234"
                }
              },
              "required": [
                "email",
                "otp"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OTP verified and consumed; no reset token is issued.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "OTP verified. Password reset is not available yet."
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Missing email or OTP, expired/invalid code, incorrect code, or attempt lockout.",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "error"
                },
                "message": {
                  "type": "string",
                  "example": "Email and otp are required!"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Unexpected request handling or Redis failure.",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Something went wrong please try again"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          }
        }
      }
    }
  }
}