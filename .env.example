# Copy to .env at the repository root; replace placeholders locally.
DATABASE_URL=mongodb://127.0.0.1:27017/eshop
REDIS_DATABASE_URL=redis://127.0.0.1:6379
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
AUTH_SERVICE_URL=http://localhost:6001
# Optional: PORT overrides the default for whichever app you launch.
# Leave PORT unset when starting both apps together.
