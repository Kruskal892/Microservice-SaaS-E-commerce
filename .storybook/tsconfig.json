{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "paths": { "@packages/*": ["../packages/*"] }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "../packages/ui/**/*.ts",
    "../packages/ui/**/*.tsx",
    "../packages/assets/**/*.ts"
  ]
}
